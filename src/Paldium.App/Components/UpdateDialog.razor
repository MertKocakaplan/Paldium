@using System.Globalization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inherits LocalizedComponentBase
@inject UpdateService Updates
@inject IJSRuntime JS

@* The update box (screens/update.md): the new version, its notes, and the buttons; while an update is prepared it shows the progress. *@
@{
    var release = Updates.DialogOpen ? (Updates.Available ?? Updates.Latest) : null;
}
@if (release != null)
{
    var progress = Updates.Progress;
    var busy = progress.Phase != UpdatePhase.Idle;
    var culture = CultureInfo.GetCultureInfo(Lang);
    <div class="updscrim" @onclick="Close">
        <div @ref="_dialogEl" class="upd" role="dialog" aria-modal="true" aria-labelledby="upd-title" @onclick:stopPropagation="true" @onkeydown="OnKeyDown" tabindex="-1">
            <h2 id="upd-title">@L["Update.Title", release.Version]</h2>
            <p class="m">@SubtitleText(release, culture)</p>
            @if (!string.IsNullOrWhiteSpace(release.Notes))
            {
                <div class="updnotes">@((MarkupString)UpdateNotes.ToHtml(release.Notes))</div>
            }

            @if (_errorKey != null)
            {
                <p class="upderr" role="alert">@L[_errorKey]</p>
            }

            @if (busy)
            {
                <div class="updprog" role="status">
                    @if (progress.Phase == UpdatePhase.Downloading)
                    {
                        var dlText = progress.TotalBytes > 0
                            ? FormatBytes(progress.BytesRead, culture) + " / " + FormatBytes(progress.TotalBytes, culture)
                            : FormatBytes(progress.BytesRead, culture);
                        <div class="updbar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progress.Percent"><i style="@("width:" + progress.Percent + "%")"></i></div>
                        <span class="m num">@L["Update.Downloading", dlText]</span>
                    }
                    else
                    {
                        <span class="m">@L[progress.Phase == UpdatePhase.Verifying ? "Update.Verifying" : "Update.Restarting"]</span>
                    }
                </div>
                <div class="updact">
                    @if (progress.Phase == UpdatePhase.Downloading)
                    {
                        <button type="button" class="btn2" @onclick="Updates.CancelDownload">@L["Update.Cancel"]</button>
                    }
                </div>
            }
            else
            {
                <div class="updact">
                    @if (release.AssetUrl == null || _errorKey is UpdateException.NotWritable or UpdateException.UnsafeFolder)
                    {
                        <a class="btn2 acc" href="@release.PageUrl" target="_blank" rel="noopener">@L["Update.OpenRelease"]</a>
                    }
                    else
                    {
                        <button type="button" class="btn2 acc" @onclick="() => InstallAsync(release)">@L[_errorKey == UpdateException.DownloadFailed ? "Update.Retry" : "Update.Install"]</button>
                    }
                    <button type="button" class="btn2" @onclick="Close">@L["Update.Later"]</button>
                    @if (!Updates.IsSkipped(release.Version))
                    {
                        <button type="button" class="btn2" @onclick="() => Skip(release.Version)">@L["Update.Skip"]</button>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private string? _errorKey;
    private string? _releaseTag;
    private bool _installing;
    private ElementReference _dialogEl;
    private bool _attached;
    private DotNetObjectReference<UpdateDialog>? _self;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Updates.Changed += OnChanged;
    }

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(() =>
    {
        var currentTag = (Updates.Available ?? Updates.Latest)?.Tag;
        if (!Updates.DialogOpen || !string.Equals(_releaseTag, currentTag, StringComparison.Ordinal))
        {
            if (!Updates.DialogOpen) _errorKey = null;
            else if (!string.Equals(_releaseTag, currentTag, StringComparison.Ordinal)) _errorKey = null;
        }
        _releaseTag = currentTag;
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var open = Updates.DialogOpen && (Updates.Available ?? Updates.Latest) != null;
        if (open && !_attached)
        {
            _attached = true;
            _self ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("pbDrawer.attach", _dialogEl, _self);
        }
        else if (!open && _attached)
        {
            _attached = false;
            await JS.InvokeVoidAsync("pbDrawer.detach", _dialogEl, true);
        }
    }

    [JSInvokable]
    public void RequestClose() => Close();

    private bool CanClose => Updates.Progress.Phase is UpdatePhase.Idle or UpdatePhase.Downloading;

    private void Close()
    {
        if (!CanClose) return;
        _errorKey = null;
        Updates.CloseDialog();
    }

    private void Skip(string version)
    {
        if (!CanClose) return;
        _errorKey = null;
        Updates.Skip(version);
        Updates.CloseDialog();
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close();
    }

    private async Task InstallAsync(ReleaseInfo release)
    {
        if (_installing || Updates.Progress.Phase != UpdatePhase.Idle) return;
        _installing = true;
        _errorKey = null;
        try
        {
            var staged = await Task.Run(() => Updates.PrepareAsync(release));
            Updates.LaunchUpdater(staged);
            await Task.Delay(400);
            var app = System.Windows.Application.Current;
            app.Dispatcher.Invoke(app.Shutdown);
        }
        catch (UpdateException ex)
        {
            _errorKey = ex.Key;
        }
        catch (OperationCanceledException)
        {
            // "Cancel": the partial file is already gone.
        }
        finally
        {
            _installing = false;
        }
        StateHasChanged();
    }

    private string SubtitleText(ReleaseInfo release, CultureInfo culture)
    {
        var parts = new List<string> { L["Update.SubVersion", Updates.CurrentVersion].Value };
        if (release.PublishedAt is { } published)
            parts.Add(L["Update.SubReleased", Ago(published)].Value);
        if (release.AssetSize > 0)
            parts.Add(SizeText(release.AssetSize, culture));
        return string.Join(" · ", parts);
    }

    private string Ago(DateTimeOffset at)
    {
        var span = DateTimeOffset.UtcNow - at;
        if (span < TimeSpan.FromMinutes(1)) return L["Sources.AgoNow"].Value;
        if (span < TimeSpan.FromHours(1)) return L["Sources.AgoMinutes", (int)span.TotalMinutes].Value;
        if (span < TimeSpan.FromDays(1)) return L["Sources.AgoHours", (int)span.TotalHours].Value;
        return L["Sources.AgoDays", (int)span.TotalDays].Value;
    }

    public static string SizeText(long bytes, CultureInfo? culture = null) =>
        bytes <= 0 ? "" : FormatBytes(bytes, culture ?? CultureInfo.InvariantCulture);

    private static string FormatBytes(long bytes, CultureInfo culture)
    {
        var clamped = Math.Max(0, bytes);
        return (clamped / 1048576.0).ToString(clamped >= 10485760 ? "0" : "0.#", culture) + " MB";
    }

    public async ValueTask DisposeAsync()
    {
        Updates.Changed -= OnChanged;
        if (_attached)
        {
            _attached = false;
            try { await JS.InvokeVoidAsync("pbDrawer.detach", _dialogEl, false); } catch { }
        }
        _self?.Dispose();
        Dispose();
    }
}
