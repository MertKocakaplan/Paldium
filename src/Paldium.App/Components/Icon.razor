@* Inline 1.75px stroke SVG icons (one 24px grid, rounded caps and joins). *@
@if (Name.Equals("egg", StringComparison.OrdinalIgnoreCase))
{
    <svg class="@($"egg{(string.IsNullOrEmpty(Class) ? "" : " " + Class)}")" viewBox="0 0 24 30" aria-hidden="true">
        <path fill="currentColor" d="M12 1.5C6.8 1.5 2 11 2 18.2 2 24.4 6.5 28.5 12 28.5s10-4.1 10-10.3C22 11 17.2 1.5 12 1.5z" />
    </svg>
}
else
{
    <svg class="@CssClass()" viewBox="0 0 24 24" aria-hidden="true">
        @switch (Name.ToLowerInvariant())
        {
            case "search":
                <circle cx="11" cy="11" r="6.5" />
                <path d="m16 16 4.5 4.5" />
                break;
            case "info":
                <circle cx="12" cy="12" r="8.5" />
                <path d="M12 11v5.5M12 7.8v.01" />
                break;
            case "warn":
                <path d="M12 4 2.8 19.5h18.4z" />
                <path d="M12 10v4.5M12 17.2v.01" />
                break;
            case "plus":
                <path d="M12 5v14M5 12h14" />
                break;
            case "refresh":
                <path d="M19.5 12a7.5 7.5 0 1 1-2.2-5.3" />
                <path d="M19.5 4.5v4h-4" />
                break;
            case "eye":
                <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z" />
                <circle cx="12" cy="12" r="3" />
                break;
            case "filter":
                <path d="M4 6h16M7 12h10M10 18h4" />
                break;
            case "check":
                <path d="m5 12.5 4.5 4.5L19 7.5" />
                break;
            case "arrow-right":
                <path d="M5 12h14M13 6l6 6-6 6" />
                break;
            case "arrow-up":
                <path d="M12 19V5M5 12l7-7 7 7" />
                break;
            case "arrow-down":
                <path d="M12 5v14M19 12l-7 7-7-7" />
                break;
            case "ban":
                <circle cx="12" cy="12" r="8.5" />
                <path d="M6 6l12 12" />
                break;
            case "x":
            case "close":
                <path d="M6 6l12 12M18 6 6 18" />
                break;
            case "chevron-down":
                <path d="m6 9 6 6 6-6" />
                break;
            case "chevron-up":
                <path d="m18 15-6-6-6 6" />
                break;
            case "chevron-right":
                <path d="m9 6 6 6-6 6" />
                break;
            case "sort":
                <path d="M8 5v14M4.5 15.5 8 19l3.5-3.5M16 19V5M12.5 8.5 16 5l3.5 3.5" />
                break;
            case "undo":
            case "back":
                <path d="M9 14 4 9l5-5" />
                <path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11" />
                break;
            case "stop":
                <rect x="7" y="7" width="10" height="10" rx="1.5" />
                break;
            case "more":
                <circle cx="5.5" cy="12" r=".8" />
                <circle cx="12" cy="12" r=".8" />
                <circle cx="18.5" cy="12" r=".8" />
                break;
            case "pin":
                <path d="M12 21s-6-5.6-6-10.5a6 6 0 0 1 12 0C18 15.4 12 21 12 21z" />
                <circle cx="12" cy="10.5" r="2" />
                break;
            case "expand":
                <path d="M14 4h6v6M10 20H4v-6M20 4l-6.5 6.5M4 20l6.5-6.5" />
                break;
            case "edit":
                <path d="M4 20h4L19 9l-4-4L4 16z" />
                break;
            case "shelf":
                <path d="M4 5h16M4 12h16M4 19h16" />
                <path d="M8 5v14" />
                break;
            case "settings":
                <path d="M4 7h10M18 7h2M4 17h4M12 17h8" />
                <circle cx="16" cy="7" r="2" />
                <circle cx="10" cy="17" r="2" />
                break;
            case "list":
                <path d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" />
                break;
            case "grid9":
                <rect x="4" y="4" width="4" height="4" rx=".6" />
                <rect x="10" y="4" width="4" height="4" rx=".6" />
                <rect x="16" y="4" width="4" height="4" rx=".6" />
                <rect x="4" y="10" width="4" height="4" rx=".6" />
                <rect x="10" y="10" width="4" height="4" rx=".6" />
                <rect x="16" y="10" width="4" height="4" rx=".6" />
                <rect x="4" y="16" width="4" height="4" rx=".6" />
                <rect x="10" y="16" width="4" height="4" rx=".6" />
                <rect x="16" y="16" width="4" height="4" rx=".6" />
                break;
            case "grid4":
                <rect x="4.5" y="4.5" width="6.5" height="6.5" rx="1" />
                <rect x="13" y="4.5" width="6.5" height="6.5" rx="1" />
                <rect x="4.5" y="13" width="6.5" height="6.5" rx="1" />
                <rect x="13" y="13" width="6.5" height="6.5" rx="1" />
                break;
            case "minus":
                <path d="M5 12h14" />
                break;
            case "lock":
                <rect x="5.5" y="10.5" width="13" height="9" rx="1.5" />
                <path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5" />
                break;
            case "download":
                <path d="M12 4v11m0 0-4-4m4 4 4-4M5 19h14" />
                break;
        }
    </svg>
}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 16;
    [Parameter] public string? Class { get; set; }

    private string CssClass()
    {
        var sizeCls = Size is 14 or 16 or 20 ? $" s{Size}" : "";
        return string.IsNullOrEmpty(Class) ? $"i{sizeCls}" : $"i{sizeCls} {Class}";
    }
}
