@namespace Paldium.App.Pages.PlannerParts
@inherits LocalizedComponentBase

<div class="@($"join{(Current ? " now" : "")}")"
     style="@($"--x:{X}px;--y:{Y}px")"
     aria-label="@L["Plan.ExpectedEggsAria", EggsFormatted()].Value">
    <Icon Name="egg" Class="eg" />
    <span class="n">@("~" + EggsFormatted())</span>
</div>

@code {
    [Parameter] public int X { get; set; }
    [Parameter] public int Y { get; set; }
    [Parameter] public double Eggs { get; set; }
    [Parameter] public bool Current { get; set; }

    private string EggsFormatted() => Eggs.ToString("0.0", CultureInfo.GetCultureInfo(Lang));
}
