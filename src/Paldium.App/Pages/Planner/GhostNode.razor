@namespace Paldium.App.Pages.PlannerParts

<div class="ghostnode" style="@($"--x:{X}px;--y:{Y}px;height:{Height}px")" aria-hidden="true">
    <i class="c"></i>
    <i class="g-l1"></i>
    <i class="g-l2"></i>
    <i class="g-l3"></i>
</div>

@code {
    [Parameter] public int X { get; set; }
    [Parameter] public int Y { get; set; }
    [Parameter] public int Height { get; set; } = 176;
}
