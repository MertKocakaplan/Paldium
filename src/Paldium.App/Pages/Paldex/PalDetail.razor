    private static MarkupString RenderPartnerSkill(PartnerSkillInfo skill, string lang, int rank)
    {
        var index = Math.Clamp(rank, PartnerSkillText.MinRank, PartnerSkillText.MaxRank) - 1;
        var template = skill.Descriptions.Get(lang);
        var sb = new StringBuilder(template.Length + 32);
        var cursor = 0;

        foreach (Match m in PlaceholderRegex.Matches(template))
        {
            if (m.Index > cursor)
                sb.Append(WebUtility.HtmlEncode(template[cursor..m.Index]));

            var pre = m.Groups["pre"].Value;
            var name = m.Groups["name"].Value;
            var post = m.Groups["post"].Value;

            if (skill.NumbersByRank.TryGetValue(name, out var numbers) && index < numbers.Count && numbers[index] is { } number)
            {
                var formatted = Math.Round(number, 2, MidpointRounding.AwayFromZero).ToString("0.##", CultureInfo.InvariantCulture);
                sb.Append("<b class=\"pv\">")
                  .Append(WebUtility.HtmlEncode(pre))
                  .Append(WebUtility.HtmlEncode(formatted))
                  .Append(WebUtility.HtmlEncode(post))
                  .Append("</b>");
            }
            else if (TryLanguageText(skill.TextsByRank, name, lang, out var texts) && index < texts.Count && texts[index] is { } replacement)
            {
                sb.Append(WebUtility.HtmlEncode(pre))
                  .Append(WebUtility.HtmlEncode(replacement))
                  .Append(WebUtility.HtmlEncode(post));
            }
            else
            {
                sb.Append(WebUtility.HtmlEncode(m.Value));
            }

            cursor = m.Index + m.Length;
        }

        if (cursor < template.Length)
            sb.Append(WebUtility.HtmlEncode(template[cursor..]));

        var cleaned = Regex.Replace(sb.ToString(), @"[ \t]{2,}", " ").Trim();
        return new MarkupString(cleaned);
    }

    private static bool TryLanguageText(
        IReadOnlyDictionary<string, IReadOnlyDictionary<string, IReadOnlyList<string?>>> dict,
        string name,
        string lang,
        out IReadOnlyList<string?> texts)
    {
        texts = [];
        if (!dict.TryGetValue(name, out var perLang)) return false;
        if (perLang.TryGetValue(lang, out texts!)) return true;
        var dash = lang.IndexOf('-');
        if (dash > 0 && perLang.TryGetValue(lang[..dash], out texts!)) return true;
        return perLang.TryGetValue("en", out texts!);
    }

    public async ValueTask DisposeAsync()
    {
        Scope.Changed -= OnOwnedChanged;
        if (_attached)
        {
            try { await JS.InvokeVoidAsync("pbDetailNav.detach"); }
            catch (JSDisconnectedException) { }
        }
        _dotNet?.Dispose();
    }
