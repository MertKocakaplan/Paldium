@using System.Globalization
@using System.IO
@using Microsoft.JSInterop
@using System.Net
@inherits LocalizedComponentBase
@inject IGameData Data

@{
    var obtain = Pal.Obtain;
    var elementClass = Pal.Elements.Count > 0
        ? $"el-{Pal.Elements[0].ToLowerInvariant()}"
        : "el-earth";
}

<section class="dsec @elementClass" id="nerede" aria-labelledby="n-h">
    <h2 id="n-h">
        @L["Detail.WhereTitle"]
        @if (NightOnly)
        {
            <span class="nightonly"><img src="gamedata/icons/misc/Night.png" alt="" width="16" height="16" /> @L["Obtain.NightOnlyTitle"]</span>
        }
    </h2>

    @if (obtain == null)
    {
        <ul class="wl">
            <li>
                <span class="k">@Terms.ObtainMethod("Wild")</span>
                <span>@(Pal.WildLevel is not null ? string.Empty : L["Detail.NotWild"].Value)</span>
                <span class="m">@(Pal.WildLevel is { } wild ? L["Detail.WildLevelRange", wild.Min, wild.Max].Value : string.Empty)</span>
            </li>
            @if (Pal.BreedingFlags.SameSpeciesOnly)
            {
                <li>
                    <span class="k">@Term("Breeding")</span>
                    <span>@L["Paldex.SameSpeciesOnly"]</span>
                    <span class="m"></span>
                </li>
            }
        </ul>
    }
    else
    {
        var dots = DotsOf(_map);
        var hasPlot = dots.Count > 0;
        @if (_maps.Count > 1)
        {
            <Segmented TValue="string" Mini="true" Class="mapsel" Items="@MapItems()" Value="@_map" ValueChanged="ChooseMap" AriaLabel="@L["Map.MapChoice"].Value" />
        }
        <div class="where">
            @if (hasPlot)
            {
                var frame = MapFraming.Compute(dots);
                <button type="button" class="mapv" @ref="_preview" aria-label="@L["Detail.Map.OpenAria", dots.Count(d => !d.Alpha), dots.Count(d => d.Alpha)].Value" @onclick="OpenViewer">
                    @if (HasPicture(_map))
                    {
                        <img class="mimg" src="@("gamedata/map/" + PictureFile(_map))" alt="" style="@frame.ImageStyle" />
                    }
                    <span class="pts">
                        @foreach (var dot in dots)
                        {
                            <i class="@(dot.Alpha ? "a" : dot.Night ? "w n" : "w")" style="@frame.PointStyle(dot)"></i>
                        }
                    </span>
                    <span class="exp">
                        <Icon Name="expand" Size="14" />
                        <span>@L["Detail.Map.Fullscreen"]</span>
                    </span>
                </button>
            }

            <ul class="whl">
                @foreach (var group in _wild)
                {
                    <li title="@WildTitle(group)">
                        <span class="@(group.MapId != null ? "mk w" : "mk o")" aria-hidden="true"></span>
                        <span class="k">@Terms.ObtainMethod("Wild")</span>
                        <span class="@(group.MapId == ObtainMaps.Tree ? "n tagged" : "n")">
                            <span class="nm9">
                                @(group.HasName ? new MarkupString(WebUtility.HtmlEncode(group.Region)) : Raw(group.Region))
                                @if (group.Night)
                                {
                                    <text> · </text><span class="night"><img src="gamedata/icons/misc/Night.png" alt="" width="14" height="14" />@L["Obtain.Night"]</span>
                                }
                                @if (group.Aura)
                                {
                                    <text> · @L["Obtain.Aura"]</text>
                                }
                            </span>
                            @if (group.MapId == ObtainMaps.Tree)
                            {
                                <span class="maptag">@Term("Map.Tree")</span>
                            }
                        </span>
                        <span class="m">@Levels(group.LevelMin, group.LevelMax) · @L["Obtain.AreaCount", group.Areas]</span>
                    </li>
                }

                @foreach (var boss in obtain.Bosses.OrderBy(b => b.Kind, StringComparer.Ordinal).ThenBy(b => b.Level))
                {
                    <li title="@BossPosition(boss.Point)">
                        <span class="@(boss.Point.Map is ObtainMaps.Main or ObtainMaps.Tree ? (boss.Kind == "Alpha" ? "mk a" : "mk w") : "mk o")" aria-hidden="true"></span>
                        <span class="k">@(boss.Kind == "Alpha" ? Term("Alpha") : Terms.ObtainMethod("Imprisoned"))</span>
                        <span class="n">@BossPosition(boss.Point)</span>
                        <span class="m">@Levels(boss.Level, boss.Level)</span>
                    </li>
                }

                @foreach (var dungeon in obtain.Dungeons.OrderBy(d => d.Area, StringComparer.Ordinal).ThenBy(d => d.Rank, StringComparer.Ordinal))
                {
                    <li title="@(dungeon.Names.Get(Lang) + " · " + RankName(dungeon.Rank))">
                        <span class="mk o" aria-hidden="true"></span>
                        <span class="k">@Term("Dungeon")</span>
                        <span class="n">@dungeon.Names.Get(Lang) · @RankName(dungeon.Rank)</span>
                        <span class="m">@Levels(dungeon.LevelMin, dungeon.LevelMax)</span>
                    </li>
                }

                @foreach (var cage in obtain.Cages)
                {
                    <li title="@Plain(Named("Field", cage.Field))">
                        <span class="mk o" aria-hidden="true"></span>
                        <span class="k">@Terms.ObtainMethod("Cage")</span>
                        <span class="n">@Named("Field", cage.Field)</span>
                        <span class="m">@Levels(cage.LevelMin, cage.LevelMax)</span>
                    </li>
                }

                @foreach (var merchant in Merchants(obtain))
                {
                    <li title="@Plain(Named("Shop", merchant.Shop))">
                        <span class="mk o" aria-hidden="true"></span>
                        <span class="k">@Terms.ObtainMethod("Merchant")</span>
                        <span class="n">@Named("Shop", merchant.Shop)</span>
                        <span class="m">@Levels(merchant.LevelMin, merchant.LevelMax)</span>
                    </li>
                }

                @foreach (var fishing in obtain.Fishing)
                {
                    <li title="@Plain(Named("Fishing", fishing.Group))">
                        <span class="mk o" aria-hidden="true"></span>
                        <span class="k">@Terms.ObtainMethod("Fishing")</span>
                        <span class="n">@Named("Fishing", fishing.Group)</span>
                        <span class="m">@Levels(fishing.LevelMin, fishing.LevelMax)</span>
                    </li>
                }

                @foreach (var raid in obtain.Raids)
                {
                    <li>
                        <span class="mk o" aria-hidden="true"></span>
                        <span class="k">@Terms.ObtainMethod("Raid")</span>
                        <span class="n">@Terms.ObtainMethod("Raid")</span>
                        <span class="m">@Levels(raid.Level, raid.Level)</span>
                    </li>
                }

                @if (obtain.TowerBoss)
                {
                    <li>
                        <span class="mk o" aria-hidden="true"></span>
                        <span class="k">@Terms.ObtainMethod("TowerBoss")</span>
                        <span class="n">@Terms.ObtainMethod("TowerBoss")</span>
                        <span class="m"></span>
                    </li>
                }

                @if (Pal.BreedingFlags.Unbreedable)
                {
                    <li>
                        <span class="mk o" aria-hidden="true"></span>
                        <span class="k">@Term("Breeding")</span>
                        <span class="n">@L["Obtain.Unbreedable", Term("Breeding")]</span>
                        <span class="m"></span>
                    </li>
                }
                else if (Pal.BreedingFlags.SameSpeciesOnly)
                {
                    <li>
                        <span class="mk o" aria-hidden="true"></span>
                        <span class="k">@Term("Breeding")</span>
                        <span class="n">@Terms.ObtainMethod("SameSpeciesOnly")</span>
                        <span class="m"></span>
                    </li>
                }
            </ul>
        </div>

        @if (hasPlot)
        {
            <p class="h">@L[HasPicture(_map) ? "Detail.PlotHintMap" : "Detail.PlotHint"]</p>
        }
        @if (!obtain.Methods.Any(m => GameData.NonBreedingMethods.Contains(m)))
        {
            <p class="h">@L["Obtain.BreedingOnly"]</p>
        }
    }
</section>

@if (_viewerOpen)
{
    <MapViewer Pal="@Pal" Places="@_places" InitialMap="@_map" OnClose="CloseViewerAsync" />
}

@code {
    private List<WildGroup> _wild = [];
    private readonly Dictionary<string, List<MapDot>> _dots = new(StringComparer.Ordinal);
    private List<MapPlace> _places = [];
    private IReadOnlyList<string> _maps = [];
    private string _map = ObtainMaps.Main;
    private string? _loadedFor;
    private string? _loadedLang;
    private bool _viewerOpen;
    private ElementReference _preview;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private ObtainPlaces Text => new(L, Terms, Lang);

    private string Levels(int min, int max) => Text.Levels(min, max);

    private string BossPosition(MapPoint point) => Text.BossPosition(point);

    private static string Plain(MarkupString markup) => ObtainPlaces.Plain(markup);

    [Parameter, EditorRequired] public PalSpecies Pal { get; set; } = default!;

    protected override void OnParametersSet()
    {
        if (_loadedFor == Pal.Id && _loadedLang == Lang) return;
        var newPal = _loadedFor != Pal.Id;
        if (newPal) _viewerOpen = false;
        _loadedFor = Pal.Id;
        _loadedLang = Lang;

        var obtain = Pal.Obtain;
        _wild = Text.Wild(obtain);

        BuildMapData(obtain);
        // The choice is not remembered: another species starts on its own default map.
        if (newPal || !_maps.Contains(_map)) _map = obtain == null ? ObtainMaps.Main : ObtainMaps.Default(obtain);
    }

    // Every wild spawn area of the species is a night-only one (obtain.wild[].night): the title says so (T116).
    private bool NightOnly => _wild.Count > 0 && _wild.All(g => g.Night);   // the same rule as WildDots.AllNight, on the grouped areas

    private static string PictureFile(string map) => map == ObtainMaps.Tree ? "tree-map.png" : "world-map.png";

    // The picture of a map when the bundle has it; without it the preview shows the dots only.
    private static bool HasPicture(string map) =>
        File.Exists(Path.Combine(AppContext.BaseDirectory, "wwwroot", "gamedata", "map", PictureFile(map)));

    private List<MapDot> DotsOf(string map) => _dots.TryGetValue(map, out var dots) ? dots : [];

    private IReadOnlyList<SegmentedItem<string>> MapItems() => _maps.Select(m => new SegmentedItem<string>(m,
        L["Detail.MapAreas", Term(m == ObtainMaps.Tree ? "Map.Tree" : "Map.MainMap"), ObtainMaps.AreaCount(Pal.Obtain!, m)].Value, IsWord: true)).ToList();

    private void ChooseMap(string map) => _map = map;

    // The preview shows every spawn area of a map once (points close together share a dot); the viewer gets the places with all their points.
    private void BuildMapData(ObtainInfo? obtain)
    {
        _dots.Clear();
        _places = [];
        _maps = [];
        if (obtain == null) return;
        _maps = ObtainMaps.Of(obtain);

        foreach (var map in _maps)
        {
            var dots = WildDots.Preview(obtain.Wild, (pt, night) => ObtainMaps.Dot(pt, alpha: false, night: night), out _, map);
            dots.AddRange(obtain.Bosses.Where(b => b.Point.Map == map).Select(b => ObtainMaps.Dot(b.Point, alpha: true)));
            _dots[map] = dots;
        }

        _places = Text.Places(obtain);
    }

    private async Task OpenViewer()
    {
        _viewerOpen = true;
        await Task.CompletedTask;
    }

    // The preview gets the focus back when the viewer closes.
    private async Task CloseViewerAsync()
    {
        _viewerOpen = false;
        StateHasChanged();
        try { await _preview.FocusAsync(); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private string WildTitle(WildGroup group) =>
        group.Region + (group.Night ? " · " + L["Obtain.Night"].Value : "") + (group.Aura ? " · " + L["Obtain.Aura"].Value : "");

    private MarkupString Named(string kind, string raw)
    {
        if (kind == "Shop" && raw.StartsWith("Dark_", StringComparison.Ordinal))
            return new MarkupString(WebUtility.HtmlEncode(Term("BlackMarketeer")));
        if (Terms.TryT($"Area.{kind}.{raw}") is { } gameName)
        {
            if (kind == "Field" && raw.StartsWith("SeaBase_", StringComparison.Ordinal))
                gameName += $" ({L["Obtain.SeaSuffix"].Value})";
            return new MarkupString(WebUtility.HtmlEncode(gameName));
        }
        var text = L[$"Obtain.{kind}.{raw}"];
        return text.ResourceNotFound
            ? Raw(raw)
            : new MarkupString(WebUtility.HtmlEncode(text.Value));
    }

    private static MarkupString Raw(string raw) =>
        new($"<span class=\"m\">{WebUtility.HtmlEncode(raw)}</span>");

    private static List<MerchantEntry> Merchants(ObtainInfo obtain) =>
        obtain.Merchants.Where(m => !m.Shop.StartsWith("Test_", StringComparison.Ordinal)).ToList();

    private string RankName(string rank) => L["Obtain.Rank" + rank] is { ResourceNotFound: false } text ? text.Value : rank;
}
