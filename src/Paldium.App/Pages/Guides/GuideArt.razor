@* The small line diagram of a library card (mockup .art2). One per guide topic; all strokes come from the card css. *@
<span class="art2">
    <svg viewBox="0 0 120 48" aria-hidden="true">
        @switch (Art)
        {
            case "power-line":
                <line x1="6" y1="30" x2="114" y2="30" />
                <circle cx="20" cy="30" r="4" class="a" />
                <circle cx="100" cy="30" r="4" class="a" />
                <line x1="60" y1="16" x2="60" y2="38" class="d" />
                <circle cx="56" cy="30" r="5" class="k" />
                break;
            case "dice":
                <rect x="8" y="26" width="16" height="16" class="b" />
                <rect x="30" y="31" width="16" height="11" class="b" />
                <rect x="52" y="35" width="16" height="7" class="b" />
                <rect x="74" y="38" width="16" height="4" class="b" />
                <path d="M98 14l8 8-8 8" class="d" />
                break;
            case "cake":
                <rect x="38" y="20" width="44" height="20" rx="3" class="b" />
                <rect x="44" y="12" width="32" height="10" rx="3" class="a2" />
                <line x1="60" y1="4" x2="60" y2="12" class="d" />
                break;
            case "eggs":
                @for (var row = 0; row < 3; row++)
                {
                    @for (var col = 0; col < 10; col++)
                    {
                        <circle cx="@(14 + col * 10)" cy="@(14 + row * 10)" r="3" class="@(row == 0 && col == 7 ? "k" : "o")" />
                    }
                }
                break;
            case "iv":
                <rect x="10" y="12" width="70" height="6" class="b" />
                <rect x="10" y="22" width="88" height="6" class="b" />
                <rect x="10" y="32" width="54" height="6" class="b" />
                break;
            case "import":
                <rect x="12" y="10" width="34" height="28" rx="3" class="b" />
                <path d="M52 24h20" class="d" />
                <path d="M66 18l6 6-6 6" class="d" />
                <rect x="78" y="10" width="30" height="28" rx="3" class="a2" />
                break;
            default:
                <rect x="10" y="10" width="22" height="28" rx="3" class="a2" />
                <rect x="36" y="10" width="22" height="28" rx="3" class="b" />
                <rect x="62" y="10" width="22" height="28" rx="3" class="b" />
                <rect x="88" y="10" width="22" height="28" rx="3" class="b" />
                break;
        }
    </svg>
</span>

@code {
    [Parameter] public string Art { get; set; } = "";
}
