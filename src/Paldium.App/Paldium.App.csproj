<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <RootNamespace>Paldium.App</RootNamespace>
    <AssemblyName>Paldium</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paldium.Core\Paldium.Core.csproj" />
    <ProjectReference Include="..\Paldium.Import\Paldium.Import.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.130" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.15" />
    <PackageReference Include="MudBlazor" Version="9.12.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!--
    The data bundle (repo-level data/) is copied twice:
    - data/*.json next to the exe, where GameDataLoader reads it (AppContext.BaseDirectory/data);
    - data/icons/** under wwwroot/gamedata/icons, where the web view serves it.
  -->
  <ItemGroup>
    <Content Include="..\..\content\**\*.md" Link="content\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\mod\PaldiumBridge\**\*" Link="mod\PaldiumBridge\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\*.json" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\map\*.png" Link="wwwroot\gamedata\map\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\icons\**\*.png" Link="wwwroot\gamedata\icons\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
