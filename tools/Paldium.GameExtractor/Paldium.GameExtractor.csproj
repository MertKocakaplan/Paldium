<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <!-- NU1903: Microsoft.Bcl.Memory 9.0.0 is a transitive dependency of CUE4Parse. This is an offline developer tool
         that only reads the user's own game files, so the advisory does not apply. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202607" />
  </ItemGroup>

</Project>
